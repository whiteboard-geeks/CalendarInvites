# Copy outside the repo to /etc/calendar-invites/bridge.env. Values are paths only.
BRIDGE_REGISTRY_FILE=/run/calendar-config/registry.toml
DATABASE_URL_FILE=/run/calendar-config/database_url
BRIDGE_OPERATOR_TOKEN_FILE=/run/calendar-config/operator_token
INSTANTLY_API_KEY_FILE=/run/calendar-config/instantly_api_key
CLOSE_API_KEY_FILE=/run/calendar-config/close_api_key
GOOGLE_CALENDAR_CREDENTIAL_FILE=/run/calendar-config/google_calendar_credential.json
GOOGLE_OUTREACH_CREDENTIAL_FILE=/run/calendar-config/google_outreach_credential.json
GRAPH_CALENDAR_CREDENTIAL_FILE=/run/calendar-config/graph_calendar_credential.json
BRIDGE_NEW_SENDS=false
BRIDGE_DRY_RUN=true
# Independently proven with real current/stale ETags, 2026-09-09. Kill switch if regression.
BRIDGE_IMPORT_CAS_VERIFIED=true
BRIDGE_POLL_SECONDS=60
